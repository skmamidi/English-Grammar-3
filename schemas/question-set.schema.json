{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-language-mastery.local/schemas/question-set.schema.json",
  "title": "Question Set",
  "type": "object",
  "required": ["title", "topic", "questions"],
  "additionalProperties": true,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./question.schema.json"
      }
    }
  }
}

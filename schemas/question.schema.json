{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-language-mastery.local/schemas/question.schema.json",
  "title": "Question",
  "type": "object",
  "required": ["id", "version", "contentHash", "question", "metadata"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "correct": {
      "type": "integer",
      "minimum": 0
    },
    "explanation": {
      "type": "object",
      "properties": {
        "correct": {
          "type": "string"
        },
        "incorrect": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": ["choice", "reason"],
                "properties": {
                  "choice": { "type": "string" },
                  "category": { "type": "string" },
                  "reason": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "studyAid": {
      "type": "object",
      "properties": {
        "definition":    { "type": "string" },
        "example":       { "type": "string" },
        "strategyClue": {
          "type": "string",
          "description": "A process hint shown via the Strategy Clue button. Guides students HOW to think through the question without revealing the correct answer. Must not contain or strongly imply the correct choice text."
        },
        "link":          { "type": "string" },
        "linkText":      { "type": "string" },
        "internalLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["targetSetId"],
            "properties": {
              "targetSetId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
              },
              "reason": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["sourceSet", "sequence", "gradeLevels", "difficultyByGrade", "skills"],
      "additionalProperties": true,
      "properties": {
        "sourceSet": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "gradeLevels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer"
          }
        },
        "difficultyByGrade": {
          "type": "object",
          "minProperties": 1
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
